# PROPOSAL from rotn-data for harness-ops (owner of .github/workflows/). Not active here.
# Suggested path: .github/workflows/dumper-build.yml
#
# Builds the RotN dumper jar (tools/dumper, ADR 0004) with JDK 8 and uploads it as an
# artifact. No secrets, read-only token, no Hetzner access. harness-ops: please pin the
# setup-java, cache and upload-artifact actions by commit SHA like ci.yml does.
name: dumper-build

on:
  workflow_dispatch:
  pull_request:
    paths: ['tools/dumper/**']

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-java@PIN-ME # v4 or later
        with:
          distribution: temurin
          java-version: '8'
      - uses: actions/cache@PIN-ME
        with:
          path: |
            ~/.cache/rotndump
            ~/.gradle/caches
          key: rotndump-${{ hashFiles('tools/dumper/build.gradle', 'tools/dumper/build.sh') }}
      - name: Build the dumper (pinned Gradle 4.10.3, ForgeGradle 2.3)
        run: tools/dumper/build.sh
      - uses: actions/upload-artifact@PIN-ME
        with:
          name: rotndump-jar
          path: tools/dumper/build/libs/rotndump-*.jar
          retention-days: 14
          if-no-files-found: error
