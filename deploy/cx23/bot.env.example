# Per-bot environment for mindcraft-rotn@<bot>.service. `bootstrap.sh add-bot <bot>` writes a copy to
# /etc/mindcraft-rotn/<bot>.env (root:root, 0600: only systemd, as root, reads it) with __BOT__ and the
# ports filled in.
# The human then replaces the OpenRouter placeholder on the CX23 itself. Never commit a real key.
# systemd reads this file literally: no quotes are stripped, no ${...} or %i is expanded.
#
# check-env refuses to start the bot if this file sets INSECURE_CODING or BLOCKED_ACTIONS (at all),
# a DEBUG that could reach prismarine-auth, NODE_OPTIONS other than --max-old-space-size, or
# SETTINGS_JSON keys other than auth ("microsoft"), host, port and auto_open_ui (false).
# MINDCRAFT_SINGLE_BOT_SERVICE=1 comes from the unit; do not set it here.

# Microsoft token cache for this bot only (prismarine-auth). 0700, owned by mindcraft-rotn.
MINDCRAFT_PROFILES_FOLDER=/var/lib/mindcraft-rotn/__BOT__/msa

# Set by the human on the CX23 (a key with its own OpenRouter spending limit, ops.md section 4).
OPENROUTER_API_KEY=<set-by-human-never-in-repo>

# Which Mindcraft profile this bot runs (skills-rotn owns profiles/).
PROFILES=["./profiles/__BOT__.json"]

# The Minecraft server, and this bot's MindServer port (bound to localhost only; reach it through
# an SSH tunnel: ssh -L __MINDSERVER_PORT__:localhost:__MINDSERVER_PORT__ deploy@<cx23>).
SETTINGS_JSON={"host":"<minecraft-server-host>","auto_open_ui":false}
MINECRAFT_PORT=25565
MINDSERVER_PORT=__MINDSERVER_PORT__

# Node heap below the unit's MemoryHigh=1G (ops.md section 5, to be confirmed in the soak).
NODE_OPTIONS=--max-old-space-size=768
