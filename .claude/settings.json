{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git switch*)",
      "Bash(git checkout -b*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push origin agent/*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npx eslint*)",
      "Bash(node *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(orca *)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Read(./keys.json)",
      "Read(./**/keys.json)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/nmp-cache/**)",
      "Read(./deploy/secrets/**)",
      "Read(~/.ssh/**)",
      "Bash(git push origin develop*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(*--dangerously-skip-permissions*)"
    ]
  }
}
