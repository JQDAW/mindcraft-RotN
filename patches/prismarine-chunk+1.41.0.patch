+// Forge 1.12 gives some block states a network id whose meta is not the state's
+// getMetaFromState (GameData.BlockCallbacks.onAdd's second pass; double_plant's upper
+// half is sent as meta 11 but is meta 10). `registry.stateIdRemap` (a Map from network
+// state id to the id a real Forge client resolves it to, same block, set by forge-bridge
+// from rotn-data's table) makes every reader (blockAt, findBlocks, palettes) see the
+// client's id. No map, or an id not in it: unchanged. load() treats its input as network
+// data and remaps it exactly once; setBlockStateId is a local write and is never remapped
+// (mineflayer's patched block_change/multi_block_change remap network ids before it), so a
+// cycle in the table (0 -> 1, 1 -> 2, 2 -> 0) is safe. mindcraft-rotn forge-bridge.
+function remapStateId (registry, stateId) {
+  const remap = registry && registry.stateIdRemap
+  if (!remap || remap.size === 0) return stateId
+  const to = remap.get(stateId)
+  return to === undefined ? stateId : to
+}
+
+function remapGlobalData (registry, dataArray) {
+  const remap = registry && registry.stateIdRemap
+  if (!remap || remap.size === 0) return
+  const max = 2 ** dataArray.getBitsPerValue()
+  for (let i = 0; i < 4096; i++) {
+    const from = dataArray.get(i)
+    const to = remap.get(from)
+    if (to === undefined) continue
+    if (to < max) { dataArray.set(i, to); continue }
+    // Same-block remaps never need a wider array (2 ** bits is a multiple of 16), so this
+    // only happens with a map that crosses blocks. Leave the id as sent, count it on the
+    // map (remap.skippedTooWide) and log the first one per map.
+    remap.skippedTooWide = (remap.skippedTooWide || 0) + 1
+    if (remap.skippedTooWide === 1) {
+      console.warn(`state-id remap: global-palette target ${to} (from ${from}) does not fit the section's ${dataArray.getBitsPerValue()} bits; left as sent (counted in stateIdRemap.skippedTooWide)`)
+    }
+  }
+}
+
+function readVarIntBiomes (reader, end) {
+  try {
+    const n = varInt.read(reader)
+    if (n !== 256) return null
+    const out = new Array(n)
+    for (let i = 0; i < n; i++) out[i] = varInt.read(reader)
+    return reader.readOffset === end ? out : null
+  } catch (e) {
+    return null
+  }
+}
