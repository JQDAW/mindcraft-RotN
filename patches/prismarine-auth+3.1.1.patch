+// Mindcraft-RotN patch: a loggable summary of an auth error, with a leading HTTP status,
+// the error class, a code and an Xbox XErr. Never the message (checkStatus puts the
+// response body in it), never a cause's message, never the error object.
+function errorSummary (e) {
+  const message = typeof e?.message === 'string' ? e.message : ''
+  const status = /^([1-5][0-9][0-9]) /.exec(message)
+  const name = typeof e?.name === 'string' && /^[A-Za-z_][A-Za-z0-9_]{0,40}$/.test(e.name) ? e.name : 'Error'
+  const pick = (c) => typeof c === 'string' && /^[A-Za-z][A-Za-z0-9_]{1,40}$/.test(c) ? c : null
+  const code = pick(e?.code) ?? pick(e?.cause?.code) ?? pick(e?.errorCode)
+  const xerr = Number.isSafeInteger(e?.xerr) ? `XErr ${e.xerr}` : null
+  return [status ? `HTTP ${status[1]}` : null, name, code, xerr].filter(Boolean).join(', ')
